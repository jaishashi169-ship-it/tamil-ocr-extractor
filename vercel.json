{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "backend/app/main.py": {
      "excludeFiles": "{backend/tests/**,backend/alembic/**,docs/**,samples/**,**/*.md,**/*.pyc,__pycache__/**,.venv/**,**/*.sqlite,**/*.db,**/*.png,**/*.jpg,**/*.jpeg,**/*.pdf,**/*.zip,backend/private_storage/**,private_storage/**}"
    },
    "app/main.py": {
      "excludeFiles": "{backend/tests/**,backend/alembic/**,docs/**,samples/**,**/*.md,**/*.pyc,__pycache__/**,.venv/**,**/*.sqlite,**/*.db,**/*.png,**/*.jpg,**/*.jpeg,**/*.pdf,**/*.zip,backend/private_storage/**,private_storage/**}"
    }
  },
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app/main.py"
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "daemons": {
    "celery": {
      "root": "backend/",
      "entrypoint": "Dockerfile.worker",
      "command": [
        "celery",
        "-A",
        "app.tasks.celery_app",
        "worker",
        "--loglevel=info",
        "--concurrency=2"
      ],
      "instances": {
        "iad1": 1
      },
      "resources": {
        "requests": {
          "memory": "2Gi"
        }
      }
    }
  },
  "crons": [
    {
      "path": "/api/v1/internal/cron/retention",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/blob/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/health/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
