FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# Isolated OCR & document-processing worker with Tesseract (tam + eng), Poppler, LibreOffice, and Noto Tamil fonts
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-tam \
    tesseract-ocr-eng \
    poppler-utils \
    libreoffice-writer \
    fonts-noto-core \
    fonts-noto-extra \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt requirements-worker.txt /app/
RUN pip install --no-cache-dir -r /app/requirements-worker.txt

COPY . /app

RUN mkdir -p /data/private_storage && useradd -m -u 10001 appuser && chown -R appuser:appuser /app /data/private_storage
USER appuser

# Verify Tesseract (tam + eng), LibreOffice, registered Celery tasks, and bilingual OCR execution smoke test with transcript accuracy
RUN tesseract --list-langs && \
    soffice --version && \
    python -c "import json; from app.tasks import collect_worker_runtime_status; s = collect_worker_runtime_status(True); print('WORKER_OCR_SMOKE_TEST:', json.dumps(s, ensure_ascii=False)); assert s['available'] and s['tamil_accuracy'] >= 0.85 and s['english_accuracy'] >= 0.85, s"

CMD ["celery", "-A", "app.tasks.celery_app", "worker", "--loglevel=info", "--concurrency=2"]
