# Tamil English Document Studio - Environment Configuration Example
# Copy to .env and replace placeholder values before running in production.
# Never commit real secrets or passwords.

APP_NAME="Tamil English Document Studio"
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=120
DOWNLOAD_TOKEN_EXPIRE_SECONDS=900

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://studio:studio_dev_password@postgres:5432/tamil_doc_studio
SYNC_DATABASE_URL=postgresql+psycopg2://studio:studio_dev_password@postgres:5432/tamil_doc_studio

# Redis (Job Queue & Progress Cache)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
# Local dev only; ignored/disabled in APP_ENV=production
ALLOW_BACKGROUND_TASK_FALLBACK=true

# Private Object Storage (local or s3/minio)
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/data/private_storage
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET_NAME=tamil-doc-studio-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace-with-minio-secret
S3_REGION=us-east-1

# Upload & Processing Limits
MAX_UPLOAD_BYTES=500000000
UPLOAD_CHUNK_BYTES=5242880
S3_MULTIPART_PART_BYTES=8388608
MAX_BATCH_FILES=25
MAX_PDF_PAGES=500
MAX_IMAGE_PIXELS=100000000
JOB_TIMEOUT_SECONDS=1800
JOB_LEASE_SECONDS=300
WORKER_MAX_MEMORY_MB=2048
DEFAULT_RETENTION_DAYS=7

# OCR & Conversion Binaries
TESSERACT_CMD=tesseract
LIBREOFFICE_CMD=soffice
ENABLE_ISOLATED_LIBREOFFICE=true

# Required LLM API for Study Studio generation (returns HTTP 503 AI_PROVIDER_UNCONFIGURED when unset)
OPENAI_API_KEY=
GEMINI_API_KEY=
STUDY_MAX_COST_USD=2.00

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAX_UPLOAD_BYTES=500000000
